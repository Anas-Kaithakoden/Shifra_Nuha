# ---------------------------------------------------------------------------
# Shifra Nuha Technologies — build-time configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.production`) and fill in the values you
# have. Every one of them is optional: anything left blank simply stays a
# clearly labelled placeholder in the UI. Nothing here is a real value.
#
# Vite only exposes variables prefixed with VITE_.

# Public contact number, display form. Used by "Call Now".
# VITE_PHONE_NUMBER=+91 98765 43210

# WhatsApp number in international format — digits only, no + and no spaces.
# Required for the wa.me links behind every "Chat on WhatsApp" button.
# VITE_WHATSAPP_NUMBER=919876543210

# Public contact email.
# VITE_EMAIL=hello@example.com

# Live domain, no trailing slash. Until this is set the site withholds
# canonical URLs, og:url and sitemap.xml rather than publishing a wrong address.
# VITE_WEBSITE_DOMAIN=https://www.example.com

# Meta (Facebook) Pixel ID from Events Manager. No pixel is loaded while empty.
# VITE_META_PIXEL_ID=000000000000000

# Google Analytics 4 measurement ID. Same behaviour.
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
